+                matches: name => name.includes('שאילתות אצווה'),
+                load: file => processQueryExcel({ target: { files: [file], value: '' } }, 'batch')
+            },
+            {
+                type: 'debt',
+                matches: name => name.includes('חובות') && !name.includes('חשבוניות שהותאמו'),
+                load: file => processExcel({ target: { files: [file], value: '' } })
+            }
+        ];
+
+        const DATA_FOLDER_DB_NAME = 'collecting-dashboard-file-access';
+        const DATA_FOLDER_DB_STORE = 'handles';
+        const DATA_FOLDER_HANDLE_KEY = 'collecting-data-folder';
+        let bulkFolderLoadInProgress = false;
+
+        function normalizeSourceFileName(fileName) {
+            return String(fileName || '')
+                .replace(/\.(xlsx|xls)$/i, '')
+                .replace(/[\-_]+/g, ' ')
+                .replace(/\s+/g, ' ')
+                .trim();
+        }
+
+        function getDateFromSourceFileName(fileName) {
+            const numbers = normalizeSourceFileName(fileName).match(/\d+/g)?.map(Number) || [];
+            let year;
+            let month = 1;
+            let day = 1;
+            if (numbers.length >= 3 && numbers[0] >= 2000) {
+                [year, month, day] = numbers;
+            } else if (numbers.length >= 3 && numbers[2] >= 2000) {
+                [day, month, year] = numbers;
+            } else if (numbers.length >= 2 && numbers[0] >= 2000) {
+                [year, month] = numbers;
+            } else if (numbers.length >= 2 && numbers[1] >= 2000) {
+                [month, year] = numbers;
+            }
+            if (!year || month < 1 || month > 12 || day < 1 || day > 31) return 0;
+            const score = Date.UTC(year, month - 1, day);
+            const verified = new Date(score);
+            return verified.getUTCFullYear() === year && verified.getUTCMonth() === month - 1 && verified.getUTCDate() === day
+                ? score
+                : 0;
+        }
+
+        function selectLatestSourceFiles(files) {
+            const selected = new Map();
+            BULK_SOURCE_DEFINITIONS.forEach(definition => {
+                const candidates = files
+                    .filter(file => definition.matches(normalizeSourceFileName(file.name)))
+                    .sort((first, second) => {
+                        const dateDifference = getDateFromSourceFileName(second.name) - getDateFromSourceFileName(first.name);
+                        if (dateDifference !== 0) return dateDifference;
+                        const modifiedDifference = (second.lastModified || 0) - (first.lastModified || 0);
+                        return modifiedDifference !== 0 ? modifiedDifference : second.name.localeCompare(first.name, 'he');
+                    });
+                if (candidates[0]) selected.set(definition.type, candidates[0]);
+            });
+            return selected;
+        }
+
+        function openDataFolderDatabase() {
+            return new Promise((resolve, reject) => {
+                if (!window.indexedDB) {
+                    reject(new Error('IndexedDB is unavailable'));
+                    return;
                 }
-            };
-            const source = sourceElements[type];
+                const request = indexedDB.open(DATA_FOLDER_DB_NAME, 1);
+                request.onupgradeneeded = () => {
+                    const database = request.result;
+                    if (!database.objectStoreNames.contains(DATA_FOLDER_DB_STORE)) database.createObjectStore(DATA_FOLDER_DB_STORE);
+                };
+                request.onsuccess = () => resolve(request.result);
+                request.onerror = () => reject(request.error);
+            });
+        }
+
+        async function saveDataFolderHandle(directoryHandle) {
+            try {
+                const database = await openDataFolderDatabase();
+                await new Promise((resolve, reject) => {
+                    const transaction = database.transaction(DATA_FOLDER_DB_STORE, 'readwrite');
+                    transaction.objectStore(DATA_FOLDER_DB_STORE).put(directoryHandle, DATA_FOLDER_HANDLE_KEY);
+                    transaction.oncomplete = resolve;
+                    transaction.onerror = () => reject(transaction.error);
+                });
+                database.close();
+            } catch (error) {
+                console.info('לא ניתן לשמור את הרשאת התיקייה לשימוש הבא.', error);
+            }
+        }
+
+        async function getSavedDataFolderHandle() {
+            try {
+                const database = await openDataFolderDatabase();
+                const handle = await new Promise((resolve, reject) => {
+                    const request = database.transaction(DATA_FOLDER_DB_STORE, 'readonly').objectStore(DATA_FOLDER_DB_STORE).get(DATA_FOLDER_HANDLE_KEY);
+                    request.onsuccess = () => resolve(request.result || null);
+                    request.onerror = () => reject(request.error);
+                });
+                database.close();
+                return handle;
+            } catch (error) {
+                return null;
+            }
+        }
+
+        function setBulkFolderStatus(message) {
+            const status = document.getElementById('bulk-folder-load-status');
+            if (status) status.textContent = message;
+        }
+
+        function markDataSourceManualRequired(type) {
+            const source = DATA_SOURCE_UI[type];
+            if (!source) return;
+            const action = document.getElementById(source.action);
+            const status = document.getElementById(source.status);
+            const card = document.getElementById(source.card);
+            if (action) action.classList.remove('is-loaded');
+            if (card) {
+                card.classList.remove('is-loaded');
+                card.classList.add('is-manual-required');
+            }
+            if (status) status.textContent = 'יש לטעון ידנית';
+        }
+
+        function waitForSourceFileLoad(type, fileName, timeoutMs = 45000) {
+            const source = DATA_SOURCE_UI[type];
+            const status = source ? document.getElementById(source.status) : null;
+            const errorContainer = document.getElementById('data-load-message');
+            return new Promise(resolve => {
+                const startedAt = Date.now();
+                const timer = window.setInterval(() => {
+                    if (status?.textContent === fileName) {
+                        window.clearInterval(timer);
+                        resolve(true);
+                        return;
+                    }
+                    if (errorContainer && !errorContainer.classList.contains('hidden')) {
+                        window.clearInterval(timer);
+                        resolve(false);
+                        return;
+                    }
+                    if (Date.now() - startedAt >= timeoutMs) {
+                        window.clearInterval(timer);
+                        resolve(false);
+                    }
+                }, 100);
+            });
+        }
+
+        async function loadSingleBulkSource(definition, file) {
+            const source = DATA_SOURCE_UI[definition.type];
+            const status = source ? document.getElementById(source.status) : null;
+            const card = source ? document.getElementById(source.card) : null;
+            if (status) status.textContent = 'טוען...';
+            if (card) card.classList.remove('is-manual-required');
+            clearFileLoadError();
+            try {
+                definition.load(file);
+            } catch (error) {
+                markDataSourceManualRequired(definition.type);
+                return false;
+            }
+            const loaded = await waitForSourceFileLoad(definition.type, file.name);
+            if (!loaded) markDataSourceManualRequired(definition.type);
+            return loaded;
+        }
+
+        async function readSpreadsheetFilesFromDirectory(directoryHandle) {
+            const files = [];
+            for await (const [name, handle] of directoryHandle.entries()) {
+                if (handle.kind !== 'file' || name.startsWith('~$') || !/\.(xlsx|xls)$/i.test(name)) continue;
+                try {
+                    files.push(await handle.getFile());
+                } catch (error) {
+                    console.info('לא ניתן לקרוא את הקובץ ' + name, error);
+                }
+            }
+            return files;
+        }
+
+        async function runBulkFolderLoad(directoryHandle, automatic = false) {
+            if (bulkFolderLoadInProgress) return;
+            bulkFolderLoadInProgress = true;
+            const button = document.getElementById('bulk-folder-load-button');
+            if (button) button.disabled = true;
+            setBulkFolderStatus(automatic ? 'מאתר וטוען את הקבצים העדכניים מהתיקייה...' : 'סורק את התיקייה ומאתר את הקבצים העדכניים...');
+            try {
+                const files = await readSpreadsheetFilesFromDirectory(directoryHandle);
+                const selectedFiles = selectLatestSourceFiles(files);
+                let loadedCount = 0;
+                const manualTypes = [];
+                for (const definition of BULK_SOURCE_DEFINITIONS) {
+                    const file = selectedFiles.get(definition.type);
+                    if (!file) {
+                        markDataSourceManualRequired(definition.type);
+                        manualTypes.push(definition.type);
+                        continue;
+                    }
+                    setBulkFolderStatus('טוען: ' + file.name);
+                    if (await loadSingleBulkSource(definition, file)) loadedCount += 1;
+                    else manualTypes.push(definition.type);
+                }
+                clearFileLoadError();
+                if (manualTypes.length === 0) {
+                    setBulkFolderStatus('הטעינה הושלמה. נטענו הקבצים העדכניים ביותר מכל ששת הסוגים.');
+                } else {
+                    setBulkFolderStatus('הטעינה הושלמה: ' + loadedCount + ' קבצים נטענו. במקורות שלא אותרו או לא נקראו מופיעה ההודעה "יש לטעון ידנית".');
+                }
+            } catch (error) {
+                BULK_SOURCE_DEFINITIONS.forEach(definition => markDataSourceManualRequired(definition.type));
+                setBulkFolderStatus('לא ניתן לגשת לתיקייה או לקרוא את הקבצים. יש לטעון ידנית.');
+                console.info('טעינת התיקייה נכשלה.', error);
+            } finally {
+                bulkFolderLoadInProgress = false;
+                if (button) button.disabled = false;
+            }
+        }
+
+        async function loadAllDataFilesFromFolder() {
+            if (!('showDirectoryPicker' in window)) {
+                BULK_SOURCE_DEFINITIONS.forEach(definition => markDataSourceManualRequired(definition.type));
+                setBulkFolderStatus('הדפדפן אינו מאפשר גישה לתיקיות. יש לטעון ידנית.');
+                return;
+            }
+            try {
+                let directoryHandle = await getSavedDataFolderHandle();
+                if (directoryHandle) {
+                    let permission = await directoryHandle.queryPermission({ mode: 'read' });
+                    if (permission !== 'granted') permission = await directoryHandle.requestPermission({ mode: 'read' });
+                    if (permission !== 'granted') directoryHandle = null;
+                }
+                if (!directoryHandle) {
+                    directoryHandle = await window.showDirectoryPicker({ id: 'collecting-data-files', mode: 'read' });
+                }
+                await saveDataFolderHandle(directoryHandle);
+                await runBulkFolderLoad(directoryHandle, false);
+            } catch (error) {
+                if (error?.name === 'AbortError') {
+                    setBulkFolderStatus('לא נבחרה תיקייה. ניתן לנסות שוב או לטעון את הקבצים ידנית.');
+                    return;
+                }
+                BULK_SOURCE_DEFINITIONS.forEach(definition => markDataSourceManualRequired(definition.type));
+                setBulkFolderStatus('לא ניתן לגשת לתיקייה. יש לטעון ידנית.');
+                console.info('בחירת תיקיית הנתונים נכשלה.', error);
+            }
+        }
+
+        async function tryAutoLoadSavedDataFolder() {
+            const directoryHandle = await getSavedDataFolderHandle();
+            if (!directoryHandle || typeof directoryHandle.queryPermission !== 'function') return;
+            try {
+                const permission = await directoryHandle.queryPermission({ mode: 'read' });
+                if (permission === 'granted') await runBulkFolderLoad(directoryHandle, true);
+                else setBulkFolderStatus('לחיצה אחת תטען את הקבצים העדכניים. ייתכן שהדפדפן יבקש שוב הרשאת גישה לתיקייה.');
+            } catch (error) {
+                setBulkFolderStatus('לא ניתן לגשת אוטומטית לתיקייה. יש ללחוץ על הכפתור או לטעון ידנית.');
+            }
+        }
+        function markDataSourceLoaded(type, fileName) {
+            const source = DATA_SOURCE_UI[type];
             if (!source) return;
             const action = document.getElementById(source.action);
             const status = document.getElementById(source.status);
             const card = document.getElementById(source.card);
             if (action) action.classList.add('is-loaded');
-            if (card) card.classList.add('is-loaded');
+            if (card) {
+                card.classList.remove('is-manual-required');
+                card.classList.add('is-loaded');
+            }
             if (status) status.textContent = fileName || 'הקובץ נטען';
             updateDashboardAccessState();
         }
@@ -7797,6 +8094,7 @@ function getCollectionComposition(currentYearCollected, predicate = () => true)
             updateDashboardAccessState();
             syncReportYearLabels();
             navigateToScreen('sources');
+            window.setTimeout(() => tryAutoLoadSavedDataFolder(), 0);
 
             document.addEventListener('keydown', event => {
                 if (event.key !== 'Escape') return;
