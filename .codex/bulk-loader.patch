+        const DATA_SOURCE_UI = {
+            debt: { action: 'debt-file-action', status: 'debt-file-status', card: 'debt-source-card' },
+            revenue: { action: 'revenue-file-action', status: 'revenue-file-status', card: 'revenue-source-card' },
