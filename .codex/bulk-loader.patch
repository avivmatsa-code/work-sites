+
+        const BULK_SOURCE_DEFINITIONS = [
+            {
+                type: 'revenue',
+                matches: name => name.includes('הכנסות שנה נוכחית'),
+                load: file => processRevenueExcel({ target: { files: [file], value: '' } })
+            },
+            {
+                type: 'historical',
